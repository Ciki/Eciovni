{
    "name": "ondrejbrejla/eciovni",
    "description": "Component for generating invoices using Nette Framework and mPDF library.",
    "keywords": ["invoice", "generator", "nette", "latte", "mpdf"],
    "license": "BSD-3",
    "authors" : [
        {
            "name": "Ondřej Brejla",
            "email": "ondrej@brejla.cz",
            "homepage": "http://brejla.cz"
        }
    ],
    "require": {
        "php": "8.2 - 8.5",
        "nette/application": "^3.2",
        "mpdf/mpdf": "^8.1",
        "moneyphp/money": "^4.8"
    },
    "require-dev": {
        "roave/security-advisories": "dev-master",
        "phpstan/phpstan-nette": "^2.0",
        "latte/latte": "^3.0",
        "nette/tester": "^2.5",
        "symplify/easy-coding-standard": "^13.0",
		"tomasvotruba/type-coverage": "dev-main",
        "rector/rector": "dev-main"
    },
    "autoload": {
        "psr-0": {
            "OndrejBrejla": ""
        }
    },
    "scripts": {
        "phpstan": "vendor/bin/phpstan analyse -c phpstan.neon --ansi",
        "ecs": "vendor/bin/ecs check --ansi",
        "ecs-fix": "vendor/bin/ecs check --fix --ansi",
        "rector": "vendor/bin/rector process --dry-run --ansi",
        "rector-fix": "vendor/bin/rector process --ansi",
        "tester": [
            "vendor/bin/tester tests/"
        ],
        "all": [
            "@phpstan",
            "@tester"
        ]
    }
}
