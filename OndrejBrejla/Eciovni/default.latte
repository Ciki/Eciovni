{layout '@layout.latte'}

<div n:block="content">
	<div style="text-align: right; padding-bottom:8px; margin-bottom:10px; border-bottom: 2px solid #000000; color: #1A5DAC; font-weight: bold; font-size: 20px;">
		<img n:if="$supplierLogoImgSrc && file_exists($supplierLogoImgSrc)" src="{file_get_contents($supplierLogoImgSrc)|dataStream}" alt="Logo" style="max-height:35px; position:absolute; top:5px;left:8px; display:inline-block;float:left;" />
		<div style="float:right; padding-top: 10px;">{$title} {$id}</div>
	</div>

	<table style="margin-bottom:0;">
		<tr>
			<td width="54%" style="vertical-align:top;">
				<span style="color: #1A5DAC; font-weight: bold; font-size: 12px;">{_'Dodávateľ'}:</span>
				<table style="font-weight: bold;">
					<tr>
						<td>{$supplierName}</td>
					</tr>
					<tr>
						<td>{$supplierStreet} {$supplierHouseNumber}</td>
					</tr>
					<tr>
						<td>{$supplierZip} {$supplierCity}</td>
					</tr>
					<tr n:if="$supplierCountry">
						<td>{$supplierCountry}</td>
					</tr>
				</table>

				<table>
					<tr n:if="$supplierIn">
						<td width="{if $supplierVatId}50{else}40{/if}">{_'IČO'}:</td>
						<td>{$supplierIn}</td>
					</tr>
					<tr n:if="$supplierTin">
						<td>{_'DIČ'}:</td>
						<td>{$supplierTin}</td>
					</tr>
					<tr>
						{if $supplierVatId}
							<td>{_'IČ DPH'}:</td>
							<td>{$supplierVatId}</td>
						{else}
							<td colspan="2"><br>{_'Nie sme platitelia DPH'}.</td>
							{/if}
					</tr>
					<tr n:if="$supplierRegistryInfo">
						<td colspan="2">{_'Spoločnosť je zapísaná v Obchodnom registri'} {$supplierRegistryInfo}</td>
					</tr>
				</table>
			</td>

			<td width="46%" align="right" style="vertical-align: top;">
				<table style="width: 100%;">
					<tr>
						<td colspan="2">
							<span style="color: #1A5DAC; font-weight: bold; font-size: 12px;">{_'Odberateľ'}:</span>

							<table style="font-weight: bold;">
								<tr n:if="$customerName">
									<td>{$customerName}</td>
								</tr>
								<tr n:if="$customerStreet || $customerHouseNumber">
									<td>{$customerStreet} {$customerHouseNumber}</td>
								</tr>
								<tr n:if="$customerCity || $customerZip">
									<td>{$customerCity}, {$customerZip}</td>
								</tr>
								<tr n:if="$customerCountry">
									<td>{$customerCountry}</td>
								</tr>
							</table>

							<table>
								<tr n:if="$customerIn">
									<td>{_'IČO'}:</td>
									<td>{empty($customerIn) ? '' : $customerIn}</td>
								</tr>
								<tr n:if="$customerTin">
									<td>{_'DIČ'}:</td>
									<td>{$customerTin}</td>
								</tr>
								<tr n:if="$customerVatId">
									<td>{_'IČ DPH'}:</td>
									<td>{$customerVatId}</td>
								</tr>
								{*<tr n:if="$customerRegistryInfo">
									<td colspan="2">{_'Spoločnosť je zapísaná v Obchodnom registri'} {$customerRegistryInfo}</td>
								</tr>
								<tr n:if="$customerAccountNumber">
									<td>{_'Číslo účtu'}:</td>
									<td>{$customerAccountNumber}</td>
								</tr>*}
							</table>
						</td>
					</tr>
				</table>
			</td>
		</tr>

		<tr>
			<td>
				<table style="border: 2px solid #000000;">
					<tr>
						<td colspan="2">
							<span style="color: #1A5DAC; font-weight: bold; font-size: 12px;">{_'Príjemca'}:</span>

							<table style="font-weight: bold;">
								<tr n:if="$recipientName">
									<td>{$recipientName}</td>
								</tr>
								<tr n:if="$recipientStreet || $recipientHouseNumber">
									<td>{$recipientStreet} {$recipientHouseNumber}</td>
								</tr>
								<tr n:if="$recipientCity || $recipientZip">
									<td>{$recipientCity}, {$recipientZip}</td>
								</tr>
								<tr n:if="$recipientCountry">
									<td>{$recipientCountry}</td>
								</tr>
							</table>

							<table>
								<tr n:if="$recipientIn">
									<td>{_'IČO'}:</td>
									<td>{empty($recipientIn) ? '' : $recipientIn}</td>
								</tr>
								<tr n:if="$recipientTin">
									<td>{_'DIČ'}:</td>
									<td>{$recipientTin}</td>
								</tr>
								<tr n:if="$recipientVatId">
									<td>{_'IČ DPH'}:</td>
									<td>{$recipientVatId}</td>
								</tr>
								{*<tr n:if="$recipientRegistryInfo">
									<td colspan="2">{_'Spoločnosť je zapísaná v Obchodnom registri'} {$recipientRegistryInfo}</td>
								</tr>
								<tr n:if="$recipientAccountNumber">
									<td>{_'Číslo účtu'}:</td>
									<td>{$recipientAccountNumber}</td>
								</tr>*}
							</table>
						</td>
					</tr>
					<tr>
						<td width="100">{_'Forma úhrady'}:</td>
						<td>{_$paymentType}</td>
					</tr>
					<tr n:if="$supplierAccountNumber">
						<td>{_'Číslo účtu'}:</td>
						<td style="font-weight: bold" width="220">{$supplierAccountNumber}</td>
					</tr>
					<tr n:if="$variableSymbol">
						<td>{_'Variabilný symbol'}:</td>
						<td>{$variableSymbol}</td>
					</tr>
					<tr n:if="$specificSymbol">
						<td>{_'Špecifický symbol'}:</td>
						<td>{$specificSymbol}</td>
					</tr>
					<tr n:if="$constantSymbol">
						<td>{_'Konštantný symbol'}:</td>
						<td>{$constantSymbol}</td>
					</tr>
					<tr n:if="$orderNumber">
						<td>{_'Objednávka'}:</td>
						<td>{$orderNumber} <span n:if="$orderDate">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;{_'zo dňa'} {$orderDate}</span></td>
					</tr>
				</table>
			</td><td>
				<table>
					<tr n:if="$dateOfIssuance">
						<td>{_'Dátum vyhotovenia'}:</td>
						<td class="text-center">{$dateOfIssuance}</td>
					</tr>
					<tr n:if="$dueDate">
						<td>{_'Dátum splatnosti'}:</td>
						<td class="text-center">{$dueDate}</td>
					</tr>
					<tr n:if="$dateOfDelivery">
						<td>{_'Dátum dodania služby'}:</td>
						<td>{$dateOfDelivery}</td>
					</tr>
					<tr n:if="$dateOfVatRevenueRecognition">
						<td>{_'Dátum uskutočnenia zdaniteľného plnenia'}:</td>
						<td class="text-center">{$dateOfVatRevenueRecognition}</td>
					</tr>
				</table>
			</td>
		</tr>
	</table>

	<p n:if="$customText1" style="margin:0 0 5px 5px;">
		{_$customText1|breaklines}
	</p>

	<table style="width: 100%; border: 1px solid #BEC8CE;" class="items-table">
		<thead>
			<tr>
				<th class="text-left">{_'Položka'}</th>
				<th class="text-right">{_'MJ'}</th>
				<th class="text-right">{_'Počet MJ'}</th>
				<th class="text-right">{_'Cena MJ'}</th>
				<th class="text-right">{_'Cena bez DPH'}</th>
				<th class="text-right" n:if="$discountUsed">%{_'Zľava'}</th>
				<th class="text-right" n:if="$discountUsed">{_'Zľava'}</th>
				<th class="text-right" n:if="$supplierVatId">%{_'DPH'}</th>
				<th class="text-right" n:if="$supplierVatId">{_'DPH'}</th>
				<th class="text-right">{_'Celkom'} ({$currency})</th>
			</tr>
		</thead>
		<tbody n:foreach="$items as $item">
			<tr>
				<td>{$item->getDescription()}</td>
				<td class="text-right">{$item->getUnitType()}</td>
				<td class="text-right">{$item->getUnits()|round}</td>
				<td class="text-right">{$item->countUntaxedUnitValue()|round}</td>
				<td class="text-right">{$item->countUntaxedFinalValue()|round}</td>
				<td class="text-right" n:if="$discountUsed">{$item->getDiscountPercent()|round}</td>
				<td class="text-right" n:if="$discountUsed">{$item->countDiscountValue()|round}</td>
				<td class="text-right" n:if="$supplierVatId">{$item->getTax()->inUpperDecimal() * 100 - 100|round}</td>
				<td class="text-right" n:if="$supplierVatId">{$item->countTaxValue()|round}</td>
				<td class="text-right">{$item->countFinalValue()|round}</td>
			</tr>
		</tbody>
	</table>

	<table style="width: 100%; /*border: 2px solid #000000;*/">
		{if $supplierVatId}
			{if $vatSummaryItems}
				<tr>
					<td colspan="2">
						<table class="vat-summary-table">
							<tbody>
								<tr>
									<td>{_'Sadzba dane'}</td>
									<td>{_'Základ'}</td>
									<td>{_'DPH'}</td>
									<td>{_'Celkom'}</td>
								</tr>
								<tr n:foreach="$vatSummaryItems as $vsi">
									<td>{_$vsi->getDescription()}</td>
									<td>{$vsi->getAmountWithoutVat()|round}</td>
									<td>{$vsi->getAmountVat()|round}</td>
									<td>{$vsi->getAmountWithVat()|round}</td>
								</tr>
							</tbody>
						</table>
					</td>
				</tr>
			{else}
				<tr>
					<td>{_'Celkom bez DPH'} ({$currency}):</td>
					<td class="text-right">{$finalUntaxedValue|round}</td>
				</tr>
				<tr>
					<td>{_'DPH'} ({$currency}):</td>
					<td class="text-right">{$finalTaxValue|round}</td>
				</tr>
			{/if}
		{else}
		{/if}

		{var $finalValueLabel = $supplierVatId ? 'Cena celkom s DPH' : 'Cena celkom'}
		<tr style="font-size: 20px;">
			<td><strong>{_$finalValueLabel} ({$currency}):</strong></td>
			<td class="text-right"><strong>{$finalValue|round}</strong></td>
		</tr>

	</table>

	<p n:if="$customText2">
		{_$customText2|breaklines}
	</p>

	<div style="text-align: right; padding-right: 0px; margin-top:30px;" n:if="$signatureText || $signatureImgSrc">
		<img n:if="$signatureImgSrc && file_exists($signatureImgSrc)" src="{file_get_contents($signatureImgSrc)|dataStream}" alt="Razítko s podpisom" />
		{if $signatureText}
			<br>
			{_'Vystavil'}:
			<span style="font-style: italic;">{$signatureText}</span>
		{/if}
	</div>

</div>
